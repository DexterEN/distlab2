@model AuctionApp.Models.AuctionDetailsVm

@{
    ViewData["Title"] = "Details";
        // Calculate the highest bid amount (or 0 if there are no bids)
       // var maxBid = Model.Bids.Any() ? Model.Bids.Max(b => b.Amount) : 0;
}
@if (TempData["ErrorMessage"] != null)
{
<script type="text/javascript">
    alert('@TempData["ErrorMessage"]');
</script>
}


<h1>Details</h1>

<div>
    <h4>AuctionsDetailsVm</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
    </dl>
</div>

<p/>

<div>
    <h4>Bids</h4>
    <table class="table">
        <thead>
        <tr>
            <th>
                <b>Name </b>
            </th>
            <th>
                <b>Amount</b>
            </th>
            <th>
                <b>Date</b>
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Bids)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Amount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Created)
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.UserName != User.Identity.Name)
{
    <div>
        <h4>Place a Bid</h4>
        <form asp-action="PlaceBid" method="post">
            <input type="hidden" name="AuctionId" value="@Model.Id"/>

            <div class="form-group">
                <label for="BidAmount">Your Bid Amount:</label>
                <input type="number" name="BidAmount" class="form-control" required min="1" step="1" placeholder="Enter bid amount"/>
            </div>

            <button type="submit" class="btn btn-primary">Submit Bid</button>
        </form>
    </div>
}


<div>
@if (Model.UserName == User.Identity.Name)
{
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) 
}
 | <a asp-action="Index">Back to List</a>
</div>
